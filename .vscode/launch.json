{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DAPLink 烧录并调试",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/DogRobot.elf",
      "preLaunchTask": "Build DogRobot",
      "device": "STM32F103C8",
      "interface": "swd",
      "runToEntryPoint": "main",
      "serverpath": "openocd",
      "configFiles": [
        "${workspaceFolder}/.vscode/cmsis-dap.cfg",
        "target/stm32f1x.cfg"
      ],
      "openOCDLaunchCommands": [
        "transport select swd",
        "adapter speed 1000"
      ],
      "postLaunchCommands": [
        "monitor reset halt"
      ],
      "overrideRestartCommands": [
        "monitor reset halt"
      ],
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      },
      "showDevDebugOutput": "raw"
    },
    {
      "name": "STM32 ST-Link Debug",
      "type": "stlinkgdbtarget",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/build/Debug/DogRobot.elf",
      "runEntry": "main",
      "preBuild": "",
      "gdb": "${env:CUBE_BUNDLE_PATH}/gnu-gdb-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gdb.exe",
      "deviceName": "STM32F103C8T6",
      "deviceCore": "Cortex-M3",
      "deviceTrustzone": "TZ-disabled",
      "serverExe": "ST-LINK_gdbserver.exe",
      "serverCwd": "${env:CUBE_BUNDLE_PATH}/stlink-gdbserver/7.13.0+st.3/bin",
      "serverInterface": "SWD",
      "serverInterfaceFrequency": "Auto",
      "serverVerify": false,
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": "4"
      },
      "imagesAndSymbols": [
        {
          "imageFileName": "${workspaceFolder}/build/Debug/DogRobot.elf",
          "symbolFileName": "${workspaceFolder}/build/Debug/DogRobot.elf"
        }
      ]
    },
    {
      "name": "Cortex-Debug ST-Link (Peripherals)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "stlink",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/DogRobot.elf",
      "device": "STM32F103C8",
      "interface": "swd",
      "runToEntryPoint": "main",
      "svdFile": "${env:CMSIS_PACK_ROOT}/STMicroelectronics/stm32f1xx_dfp/1.2.0/SVD/STM32F103.svd",
      "armToolchainPath": "${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/14.3.1+st.2/bin",
      "gdbPath": "${env:CUBE_BUNDLE_PATH}/gnu-gdb-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gdb.exe",
      "stlinkPath": "${env:CUBE_BUNDLE_PATH}/stlink-gdbserver/7.13.0+st.3/bin/ST-LINK_gdbserver.exe",
      "serverpath": "${env:CUBE_BUNDLE_PATH}/stlink-gdbserver/7.13.0+st.3/bin/ST-LINK_gdbserver.exe",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      },
      "showDevDebugOutput": "raw"
    },
    {
      "name": "Cortex-Debug OpenOCD (Live Watch)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/DogRobot.elf",
      "device": "STM32F103C8",
      "runToEntryPoint": "main",
      "svdFile": "${env:CMSIS_PACK_ROOT}/STMicroelectronics/stm32f1xx_dfp/1.2.0/SVD/STM32F103.svd",
      "armToolchainPath": "${env:CUBE_BUNDLE_PATH}/gnu-tools-for-stm32/14.3.1+st.2/bin",
      "gdbPath": "${env:CUBE_BUNDLE_PATH}/gnu-gdb-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gdb.exe",
      "serverpath": "openocd",
      "configFiles": [
        "${workspaceFolder}/.vscode/cmsis-dap.cfg",
        "target/stm32f1x.cfg"
      ],
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      },
      "showDevDebugOutput": "raw"
    }
  ]
}
